# Copy this file to .env and fill in all values before running the server.
# NEVER commit the real .env to source control.

# Runtime
NODE_ENV=development
PORT=5001
HOST=0.0.0.0

# JWT — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Must be at least 64 hex characters (32 bytes of entropy)
JWT_SECRET=CHANGE_ME_generate_a_strong_secret_here

# MongoDB — required in production; optional in development (falls back to in-memory)
MONGODB_URI=mongodb://localhost:27017/taskflow

# CORS — comma-separated list of allowed frontend origins
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=

# Stripe — get keys from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_CHANGE_ME
STRIPE_WEBHOOK_SECRET=whsec_CHANGE_ME
STRIPE_PRO_PRICE_ID=price_CHANGE_ME_pro
STRIPE_TEAM_PRICE_ID=price_CHANGE_ME_team

# Anthropic (Claude AI) — get key from https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-CHANGE_ME

# Resend — get API key from https://resend.com
RESEND_API_KEY=re_CHANGE_ME
EMAIL_FROM=noreply@yourdomain.com

# Sentry — get DSN from https://sentry.io
SENTRY_DSN=

# Seed script (only used by: npm run seed)
SEED_EMAIL=demo@taskflow.dev
SEED_PASSWORD=DemoPass@2026!
SEED_NAME=Demo User
